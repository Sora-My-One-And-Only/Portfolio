# プレイ履歴の自動取得（npm run sync:play）に使う認証情報です。
# このファイルを .env.local という名前でコピーして、値を入れてください。
# .env.local は Git に含まれません（.gitignore 済み）。値はここ（.env.example）には書かないでください。
# GitHub Actions では、同じ名前で リポジトリの Settings → Secrets and variables → Actions に登録します。

# Steam Web API キー（https://steamcommunity.com/dev/apikey で発行）
STEAM_API_KEY=
# 自分の SteamID64（17 桁の数字）
STEAM_ID=

# PlayStation の NPSSO（https://ca.account.sony.com/api/v1/ssocookie にログイン状態でアクセスすると表示される 64 文字）
# 約 2 か月で期限が切れるので、そのときは取り直してください。
PSN_NPSSO=

# 任意: 取得するタイトル数の上限（プラットフォームごと、プレイ時間の長い順。未設定なら全件）
# PLAY_SYNC_LIMIT=50
